new file mode 100644
index 0000000..4db5b6f
--- /dev/null
+++ b/src/common/android/x7pro_governor.h
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <numeric>
+
+namespace Common::Android::X7Pro {
+enum class Drop : size_t {
+    Budget, RealDeadline, Queue, PresentDeadline, Source, Sync, Stale, Thermal, Other, Count
+};
+inline constexpr std::array DropNames{"No GPU Budget", "Real Frame Deadline", "Queue Backpressure",
+    "Present Deadline Miss", "Source Frame Invalid", "Synchronization", "Duplicate/Stale",
+    "Thermal Governor", "Other"};
+enum class Phase { Disabled, Probing, Active, Constrained };
+inline constexpr const char* PhaseName(Phase phase) {
+    switch (phase) {
+    case Phase::Disabled: return "DISABLED_TEMPORARILY";
+    case Phase::Probing: return "PROBING";
+    case Phase::Active: return "ACTIVE";
+    case Phase::Constrained: return "CONSTRAINED";
+    }
+    return "UNKNOWN";
+}
+
+// Bounded rolling window; cumulative sums are separate, never called full-session percentiles.
+template <size_t N = 300> struct Samples {
+    std::array<double, N> values{};
+    size_t count{}, next{};
+    uint64_t total_count{};
+    double total{}, maximum{};
+    void Add(double value) {
+        if (!std::isfinite(value) || value < 0) return;
+        values[next] = value;
+        next = (next + 1) % N;
+        count = std::min(count + 1, N);
+        ++total_count;
+        total += value;
+        maximum = std::max(maximum, value);
+    }
+    double Average() const {
+        return count ? std::accumulate(values.begin(), values.begin() + count, 0.0) / count : 0;
+    }
+    double Percentile(double p) const {
+        if (!count) return 0;
+        auto sorted = values;
+        std::sort(sorted.begin(), sorted.begin() + count);
+        const auto rank = static_cast<size_t>(std::ceil(std::clamp(p, 0.0, 1.0) * count));
+        return sorted[rank ? rank - 1 : 0];
+    }
+    double SlowestOnePercentMean() const {
+        if (!count) return 0;
+        auto sorted = values;
+        std::sort(sorted.begin(), sorted.begin() + count);
+        const auto slow = std::max<size_t>(1, (count + 99) / 100);
+        return std::accumulate(sorted.begin() + count - slow, sorted.begin() + count, 0.0) / slow;
+    }
+};
+
+struct Evidence {
+    double real_ms{}, real_p95{}, real_p99{};
+    double cpu_core_ms{}, gpu_ms{}, fg_ms{}, present_ms{};
+    bool gpu_valid{}, cpu_valid{}, fg_valid{}, queue_ready{}, automatic{true};
+    int thermal{-1};
+};
+struct Decision { bool admit{}; Drop reason{Drop::Other}; bool reduced_quality{true}; };
+
+// Policy only: no sleep, graphics calls, game-speed changes or device detection.
+// Thresholds are conservative starting values, not calibrated hardware benchmark results.
+class Governor {
+public:
+    static constexpr double Budget = 1000.0 / 30.0;
+    Phase phase{Phase::Disabled};
+    double margin{5.0};
+    unsigned recovery{}, admitted{}, cooldown{};
+    Drop suspension_reason{Drop::Budget};
+
+    Decision Decide(const Evidence& e) {
+        margin = std::clamp(3.0 + std::max(0.0, e.real_p95 - Budget) * 0.5, 3.0, 9.0);
+        auto reject = [&](Drop reason, bool severe) {
+            admitted = 0;
+            recovery = 0;
+            phase = severe ? Phase::Disabled : Phase::Constrained;
+            cooldown = std::max(cooldown, severe ? 60U : 15U);
+            suspension_reason = reason;
+            return Decision{false, reason, true};
+        };
+        if (e.thermal >= 3) return reject(Drop::Thermal, true);
+        if (!e.queue_ready) return reject(Drop::Queue, false);
+        // An unmeasured/unsupported GPU cannot safely pass AUTO admission.
+        if (!e.gpu_valid || !e.cpu_valid) return reject(Drop::Budget, false);
+        if (e.real_ms > 37.0 || e.real_p99 > 50.0)
+            return reject(Drop::RealDeadline, e.real_ms > 45.0 || e.real_p99 > 60.0);
+        const double real_cost = std::max(e.gpu_ms, e.cpu_core_ms);
+        const double predicted_fg = e.fg_valid ? std::max(1.0, e.fg_ms * 1.25) : 6.0;
+        if (real_cost + predicted_fg + std::max(0.0, e.present_ms) + margin >= Budget)
+            return reject(Drop::Budget, false);
+        if (!e.automatic) {
+            phase = Phase::Probing;
+            return {true, Drop::Other, false}; // Manual quality; hard safety checks remain mandatory.
+        }
+        if (cooldown) {
+            --cooldown;
+            return {false, suspension_reason, true};
+        }
+        if (phase == Phase::Disabled || phase == Phase::Constrained) {
+            if (++recovery < 30) return {false, suspension_reason, true};
+            phase = Phase::Probing;
+            admitted = 0;
+        }
+        if (++admitted >= 60 && e.fg_valid && e.real_p95 < 35.5) phase = Phase::Active;
+        // Preserve the configured image scale; reduce only search radius (no reallocations).
+        const bool reduced = phase != Phase::Active || e.thermal >= 2 ||
+            real_cost + predicted_fg + margin + 4.0 >= Budget;
+        return {true, Drop::Other, reduced};
+    }
+};
+
+inline uint64_t TimestampDelta(uint64_t begin, uint64_t end, unsigned valid_bits) {
+    if (!valid_bits) return 0;
+    const uint64_t mask = valid_bits >= 64 ? ~uint64_t{0} : (uint64_t{1} << valid_bits) - 1;
+    return (end - begin) & mask;
+}
+} // namespace Common::Android::X7Pro
