+// submission tick has completed AND both availability words have been observed. No WAIT_BIT.
+class X7ProGpuTiming {
+public:
+    explicit X7ProGpuTiming(const Device& device_) : device{device_} {}
+    void Begin(vk::CommandBuffer cmd, MasterSemaphore& master) {
+        namespace T = Common::Android::X7Pro;
+        Poll(master);
+        current = -1;
+        if (!T::Enabled() || failed) return;
+        if (!pool) {
+            const auto props = device.GetPhysical().GetProperties();
+            const auto families = device.GetPhysical().GetQueueFamilyProperties();
+            bits = families.at(device.GetGraphicsFamily()).timestampValidBits;
+            period = props.limits.timestampPeriod;
+            if (!bits || period <= 0) {
+                failed = true; T::GpuUnavailable("graphics queue timestampValidBits=0 or invalid timestampPeriod"); return;
+            }
+            try {
+                pool = device.GetLogical().CreateQueryPool({
+                    .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+                    .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = 2 * SlotCount});
+            } catch (const vk::Exception& error) {
+                failed = true; T::GpuUnavailable(error.what()); return;
+            }
+        }
+        // Poll and retire in submission order. A full ring skips instrumentation, never waits.
+        if (pending == SlotCount) { write_frame_valid = false; T::GpuUnavailable("timestamp ring full; sample skipped"); return; }
+        current = static_cast<int>((head + pending) % SlotCount);
+        cmd.ResetQueryPool(*pool, 2 * current, 2);
+        device.GetDispatchLoader().vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                                                      *pool, 2 * current);
+    }
+    void End(vk::CommandBuffer cmd, uint64_t tick, bool real_end, bool fg) {
+        if (current < 0) {
+            if (!fg) write_frame_valid = false;
+            if (real_end) { ++write_frame; write_frame_valid = true; }
+            return;
+        }
+        device.GetDispatchLoader().vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                                      *pool, 2 * current + 1);
+        slots[current] = {tick, write_frame, real_end, fg, write_frame_valid};
+        if (real_end) { ++write_frame; write_frame_valid = true; }
+        ++pending;
+        current = -1;
+    }
+private:
+    void Poll(MasterSemaphore& master) {
+        namespace T = Common::Android::X7Pro;
+        if (failed) return;
+        if (pending) master.Refresh(); // Nonblocking counter/fence refresh, not a wait.
+        while (pending && master.IsFree(slots[head].tick)) {
+            struct Result { uint64_t ticks, available; } values[2]{};
+            const auto result = device.GetLogical().GetQueryResults(*pool, head * 2, 2,
+                sizeof(values), values, sizeof(Result), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+            if (result != VK_SUCCESS) {
+                if (result == VK_NOT_READY) break;
+                failed = true; T::GpuUnavailable("vkGetQueryPoolResults returned an error"); return;
+            }
+            if (!values[0].available || !values[1].available) break;
+            const double ms = T::TimestampDelta(values[0].ticks, values[1].ticks, bits) * period / 1e6;
+            const auto slot = slots[head];
+            if (slot.fg) T::Sample(T::Metric::FgGpu, ms);
+            else {
+                if (read_frame != slot.frame) { real_ms = 0; read_frame = slot.frame; }
+                real_ms += ms;
+            }
+            if (slot.real_end) {
+                if (slot.valid) T::Sample(T::Metric::GpuReal, real_ms);
+                real_ms = 0;
+            }
+            head = (head + 1) % SlotCount;
+            --pending;
+        }
+    }
+    static constexpr uint32_t SlotCount = 128;
+    struct Slot { uint64_t tick{}, frame{}; bool real_end{}, fg{}, valid{}; };
+    const Device& device;
+    vk::QueryPool pool;
+    std::array<Slot, SlotCount> slots{};
+    uint32_t head{}, pending{}, bits{};
+    int current{-1};
+    double period{}, real_ms{};
+    uint64_t write_frame{1}, read_frame{};
+    bool failed{}, write_frame_valid{true};
+};
+} // namespace Vulkan
