+++ b/src/common/android/x7pro_telemetry.cpp
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "common/android/x7pro_telemetry.h"
+#include <android/thermal.h>
+#include <atomic>
+#include <dlfcn.h>
+#include <iomanip>
+#include <mutex>
+#include <sstream>
+#include <time.h>
+#include "common/android/poco_x7pro_profile.h"
+#include "common/logging.h"
+#include "common/settings.h"
+
+namespace Common::Android::X7Pro {
+namespace {
+using Clock = std::chrono::steady_clock;
+constexpr std::array MetricNames{"CPU busiest core/real interval", "CPU sum/real interval",
+    "GPU real submissions", "FG CPU preparation", "FG GPU (history + compute)",
+    "Shader translation CPU wall", "Pipeline creation CPU wall", "Swapchain acquire wait",
+    "Present queue age", "QueuePresent CPU call", "Render frame/fence wait", "Composite CPU wall"};
+constexpr std::array CounterNames{"real_produced", "real_presented", "synthetic_attempted",
+    "synthetic_submitted", "synthetic_generated_gpu_complete", "synthetic_presented",
+    "synthetic_skipped_or_dropped"};
+constexpr std::array Bottlenecks{"CPU BOUND", "GPU BOUND", "SHADER BOUND", "SYNC BOUND",
+    "PRESENT BOUND", "FG LIMITED", "THERMAL LIMITED", "BALANCED", "UNKNOWN"};
+std::atomic_bool enabled{};
+std::array<std::atomic<int64_t>, 4> cpu_ns{};
+std::array<std::atomic_bool, 4> cpu_seen{};
+std::atomic<int> thermal_status{-1};
+void ThermalChanged(void*, AThermalStatus status) { thermal_status.store(status, std::memory_order_relaxed); }
+struct State {
+    std::mutex mutex;
+    std::array<Samples<>, static_cast<size_t>(Metric::Count)> metrics{};
+    Samples<> real, presented;
+    std::array<uint64_t, static_cast<size_t>(Counter::Count)> counters{};
+    std::array<uint64_t, static_cast<size_t>(Drop::Count)> drops{};
+    std::array<uint64_t, Bottlenecks.size()> bottlenecks{};
+    Clock::time_point start{}, last_real{}, last_present{}, last_log{}, last_thermal{}, last_gpu{};
+    Clock::time_point last_compile{}, last_spike{};
+    double interval_compile_ms{}, interval_compile_max{}, previous_compile_ms{}, previous_compile_max{};
+    uint64_t interval_compile_events{}, previous_compile_events{};
+    Governor governor;
+    bool reduced{true};
+    std::string game, gpu_reason{"waiting for asynchronous timestamp results"};
+    std::string gpu, driver;
+    uint64_t title_id{};
+    int thermal{-1};
+    AThermalManager* thermal_manager{};
+    using AcquireThermal = AThermalManager* (*)();
+    using ReadThermal = AThermalStatus (*)(AThermalManager*);
+    using ReleaseThermal = void (*)(AThermalManager*);
+    using ThermalListener = int (*)(AThermalManager*, AThermal_StatusCallback, void*);
+    ReleaseThermal release_thermal{};
+    ThermalListener unregister_thermal{};
+    void InitializeThermal() {
+        if (thermal_manager) return;
+        // Runtime lookup retains the safe Android <30 fallback of other build variants.
+        const auto acquire = reinterpret_cast<AcquireThermal>(dlsym(RTLD_DEFAULT, "AThermal_acquireManager"));
+        const auto read = reinterpret_cast<ReadThermal>(dlsym(RTLD_DEFAULT, "AThermal_getCurrentThermalStatus"));
+        const auto reg = reinterpret_cast<ThermalListener>(dlsym(RTLD_DEFAULT, "AThermal_registerThermalStatusListener"));
+        release_thermal = reinterpret_cast<ReleaseThermal>(dlsym(RTLD_DEFAULT, "AThermal_releaseManager"));
+        unregister_thermal = reinterpret_cast<ThermalListener>(dlsym(RTLD_DEFAULT, "AThermal_unregisterThermalStatusListener"));
+        if (!acquire || !read || !reg || !release_thermal || !unregister_thermal) return;
+        thermal_manager = acquire();
+        if (!thermal_manager) return;
+        thermal_status = read(thermal_manager); // Startup only, never a binder call in the frame loop.
+        if (reg(thermal_manager, ThermalChanged, nullptr) != 0) {
+            thermal_status = -1; release_thermal(thermal_manager); thermal_manager = nullptr;
+        }
+    }
+    ~State() {
+        if (thermal_manager) {
+            unregister_thermal(thermal_manager, ThermalChanged, nullptr);
+            release_thermal(thermal_manager);
+        }
+    }
+};
+State& Get() { static State state; return state; }
+Samples<>& M(State& s, Metric metric) { return s.metrics[static_cast<size_t>(metric)]; }
+double Age(Clock::time_point t) { return std::chrono::duration<double, std::milli>(Clock::now() - t).count(); }
+size_t Bottleneck(State& s) {
+    if (s.thermal >= 3) return 6;
+    if (Age(s.last_compile) < 200 && s.interval_compile_max > 8) return 2;
+    if (M(s, Metric::FrameWait).Percentile(.95) > 8) return 3;
+    if (M(s, Metric::Acquire).Percentile(.95) > 8 || M(s, Metric::QueueAge).Percentile(.95) > 16) return 4;
+    if (M(s, Metric::GpuReal).Percentile(.95) > 28) return 1;
+    if (M(s, Metric::CpuCore).Percentile(.95) > 28) return 0;
+    if (Settings::values.mali_native_frame_gen.GetValue() && s.governor.phase == Phase::Constrained &&
+        M(s, Metric::FgGpu).count) return 5;
+    if (M(s, Metric::GpuReal).count >= 30 && M(s, Metric::CpuCore).count >= 30 && s.real.Percentile(.95) < 35.5)
+        return 7;
+    return 8;
+}
+std::string Value(const Samples<>& samples) {
+    if (!samples.count) return "N/A";
+    std::ostringstream out;
+    out << std::fixed << std::setprecision(2) << samples.Average() << " ms";
+    return out.str();
+}
+int64_t ThreadNs() {
+    timespec t{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t) != 0) return 0;
+    return int64_t{t.tv_sec} * 1000000000 + t.tv_nsec;
+}
+} // namespace
+bool Enabled() { return enabled.load(std::memory_order_relaxed); }
+void SetDevice(std::string_view gpu, std::string_view driver) {
+    auto& s = Get(); std::scoped_lock lock{s.mutex}; s.gpu = gpu; s.driver = driver;
+}
+void StartSession(std::string_view game, uint64_t title_id) {
+    const bool active = IsPocoX7ProProfileActive() && (Settings::values.mali_native_frame_gen.GetValue() ||
+        Settings::values.x7pro_detailed_performance_overlay.GetValue());
+    auto& s = Get();
+    if (active) s.InitializeThermal();
+    std::scoped_lock lock{s.mutex};
+    s.metrics = {}; s.real = {}; s.presented = {}; s.counters = {}; s.drops = {};
+    s.bottlenecks = {}; s.governor = {}; s.last_real = {}; s.last_present = {}; s.last_gpu = {};
+    s.start = s.last_log = Clock::now(); s.game = game; s.title_id = title_id;
+    s.last_compile = {}; s.last_spike = {};
+    s.interval_compile_ms = s.interval_compile_max = s.previous_compile_ms = s.previous_compile_max = 0;
+    s.interval_compile_events = s.previous_compile_events = 0;
+    for (auto& c : cpu_ns) c = 0;
+    for (auto& c : cpu_seen) c = false;
+    enabled = active;
+}
+void StopSession() {
+    if (Enabled()) LOG_INFO(Render_Vulkan, "[X7PRO-B19-SUMMARY]\n{}", Diagnostics(true));
+    enabled = false;
+}
+void RealFrame() {
+    enabled = IsPocoX7ProProfileActive() && (Settings::values.mali_native_frame_gen.GetValue() ||
+        Settings::values.x7pro_detailed_performance_overlay.GetValue());
+    if (!Enabled()) return;
+    auto& s = Get();
+    bool log = false, spike = false;
+    {
+        std::scoped_lock lock{s.mutex};
+        const auto now = Clock::now();
+        if (s.last_real != Clock::time_point{}) {
+            const double ms = std::chrono::duration<double, std::milli>(now - s.last_real).count();
+            // Pauses/surface loss are not gameplay frame samples. Re-warm the governor.
+            if (ms < 500) s.real.Add(ms); else s.governor = {};
+            if (ms > 40 && ms < 500 && Age(s.last_spike) >= 1000) {
+                spike = true; s.last_spike = now;
+            }
+        }
+        s.last_real = now;
+        ++s.counters[static_cast<size_t>(Counter::RealProduced)];
+        double sum = 0, maximum = 0;
+        bool seen = false;
+        for (size_t i = 0; i < cpu_ns.size(); ++i) {
+            seen |= cpu_seen[i].load(std::memory_order_relaxed);
+            const double ms = cpu_ns[i].exchange(0, std::memory_order_relaxed) / 1e6;
+            sum += ms; maximum = std::max(maximum, ms);
+        }
+        if (seen) { M(s, Metric::CpuSum).Add(sum); M(s, Metric::CpuCore).Add(maximum); }
+        s.thermal = thermal_status.load(std::memory_order_relaxed);
+        ++s.bottlenecks[Bottleneck(s)];
+        log = Age(s.last_log) >= 10000;
+        if (log) {
+            s.last_log = now;
+            s.previous_compile_ms = s.interval_compile_ms;
+            s.previous_compile_max = s.interval_compile_max;
+            s.previous_compile_events = s.interval_compile_events;
+            s.interval_compile_ms = s.interval_compile_max = 0;
+            s.interval_compile_events = 0;
+        }
+    }
+    if (log) LOG_INFO(Render_Vulkan, "[X7PRO-B19-SUMMARY]\n{}", Diagnostics(true));
+    else if (spike) LOG_INFO(Render_Vulkan, "[X7PRO-B19-SPIKE] asynchronous rolling evidence, not causal proof\n{}", Diagnostics());
+}
+void Sample(Metric metric, double ms) {
+    if (!Enabled()) return;
+    auto& s = Get(); std::scoped_lock lock{s.mutex};
+    M(s, metric).Add(ms);
+    if (metric == Metric::Shader || metric == Metric::Pipeline) {
+        s.interval_compile_ms += ms;
+        s.interval_compile_max = std::max(s.interval_compile_max, ms);
+        ++s.interval_compile_events;
+        s.last_compile = Clock::now();
+    }
+    if (metric == Metric::GpuReal) s.last_gpu = Clock::now();
+}
+void Count(Counter counter) {
+    if (!Enabled()) return;
+    auto& s = Get(); std::scoped_lock lock{s.mutex}; ++s.counters[static_cast<size_t>(counter)];
+}
+void Rejected(Drop reason) {
+    if (!Enabled()) return;
+    auto& s = Get(); std::scoped_lock lock{s.mutex};
+    ++s.drops[static_cast<size_t>(reason)]; ++s.counters[static_cast<size_t>(Counter::Dropped)];
+}
+void GpuUnavailable(std::string_view reason) {
+    auto& s = Get(); std::scoped_lock lock{s.mutex}; s.gpu_reason = reason;
+}
+Decision Admit(bool queue_ready) {
+    if (!Enabled() || !Settings::values.mali_native_frame_gen.GetValue()) return {};
+    auto& s = Get(); std::scoped_lock lock{s.mutex};
+    ++s.counters[static_cast<size_t>(Counter::Attempted)];
+    Evidence e{
+        .real_ms = s.real.count ? s.real.values[(s.real.next + 299) % 300] : 0,
+        .real_p95 = s.real.Percentile(.95), .real_p99 = s.real.Percentile(.99),
+        .cpu_core_ms = M(s, Metric::CpuCore).Percentile(.95),
+        .gpu_ms = M(s, Metric::GpuReal).Percentile(.95),
+        .fg_ms = M(s, Metric::FgGpu).Percentile(.95) + M(s, Metric::FgCpu).Percentile(.95),
+        .present_ms = M(s, Metric::Acquire).Percentile(.95) + M(s, Metric::PresentCall).Percentile(.95),
+        .gpu_valid = M(s, Metric::GpuReal).count >= 30 && Age(s.last_gpu) < 500,
+        .cpu_valid = M(s, Metric::CpuCore).count >= 30,
+        .fg_valid = M(s, Metric::FgGpu).count >= 2,
+        .queue_ready = queue_ready,
+        .automatic = Settings::values.x7pro_fg_governor.GetValue() != 0, .thermal = s.thermal};
+    auto decision = s.governor.Decide(e);
+    s.reduced = decision.reduced_quality;
+    if (!decision.admit) {
+        ++s.drops[static_cast<size_t>(decision.reason)];
+        ++s.counters[static_cast<size_t>(Counter::Dropped)];
+    }
+    return decision;
+}
+bool ReducedQuality() { auto& s = Get(); std::scoped_lock lock{s.mutex}; return s.reduced; }
+void Presented(bool synthetic) {
+    if (!Enabled()) return;
+    auto& s = Get(); std::scoped_lock lock{s.mutex};
+    const auto now = Clock::now();
+    if (s.last_present != Clock::time_point{} && Age(s.last_present) < 500)
+        s.presented.Add(std::chrono::duration<double, std::milli>(now - s.last_present).count());
+    s.last_present = now;
+    ++s.counters[static_cast<size_t>(synthetic ? Counter::SyntheticPresented : Counter::RealPresented)];
+}
+std::string Diagnostics(bool detailed) {
+    auto& s = Get(); std::scoped_lock lock{s.mutex};
+    std::ostringstream out; out << std::fixed << std::setprecision(2);
+    out << "REAL (last <=300 intervals)\n";
+    if (s.real.count) out << "FPS " << 1000 / s.real.Average() << " | frame " << s.real.Average()
+        << " ms\n1% low " << 1000 / s.real.SlowestOnePercentMean()
+        << " | P95 " << s.real.Percentile(.95) << " | P99 " << s.real.Percentile(.99) << " ms\n";
+    else out << "FPS / percentiles: N/A (warming up)\n";
+    out << "CPU core/sum: " << Value(M(s, Metric::CpuCore)) << " / " << Value(M(s, Metric::CpuSum))
+        << "\nGPU real: " << Value(M(s, Metric::GpuReal));
+    if (!M(s, Metric::GpuReal).count) out << " (" << s.gpu_reason << ')';
+    out << "\nAcquire / frame wait: " << Value(M(s, Metric::Acquire)) << " / " << Value(M(s, Metric::FrameWait))
+        << "\nShader / pipeline: " << M(s, Metric::Shader).total_count << " / " << M(s, Metric::Pipeline).total_count
+        << " events (CPU wall)\nFG: " << (Settings::values.mali_native_frame_gen.GetValue() ? PhaseName(s.governor.phase) : "OFF")
+        << " | margin " << s.governor.margin << " ms"
+        << "\nFG CPU / GPU: " << Value(M(s, Metric::FgCpu)) << " / " << Value(M(s, Metric::FgGpu))
+        << "\nPresented submissions: ";
+    if (s.presented.count) out << 1000 / s.presented.Average() << " FPS"; else out << "N/A";
+    out << "\nFG submitted/generated/presented/skipped: "
+        << s.counters[static_cast<size_t>(Counter::Submitted)] << '/'
+        << s.counters[static_cast<size_t>(Counter::Generated)] << '/'
+        << s.counters[static_cast<size_t>(Counter::SyntheticPresented)] << '/'
+        << s.counters[static_cast<size_t>(Counter::Dropped)]
+        << "\nBottleneck: " << Bottlenecks[Bottleneck(s)] << " | Thermal: ";
+    if (s.thermal < 0) out << "N/A (Android thermal service unavailable)"; else out << s.thermal;
+    if (!detailed) return out.str();
+    out << "\nDevice=POCO X7 Pro / Dimensity 8400 compatible target (profile gated) GPU=" << s.gpu
+        << " driver=" << s.driver;
+    out << "\nGame=" << s.game << " title_id=" << std::hex << s.title_id << std::dec
+        << " duration_wall_s=" << Age(s.start) / 1000;
+    if (s.real.total > 0) out << " real_average_active_fps=" << 1000 * s.real.total_count / s.real.total;
+    out << "\nPercentiles: nearest rank, rolling <=300 samples; 1% low = reciprocal slowest ceil(1%) mean."
+        << "\nCompile previous ~10s: events=" << s.previous_compile_events << " total_ms="
+        << s.previous_compile_ms << " max_ms=" << s.previous_compile_max
+        << "\nCompile current interval: events=" << s.interval_compile_events << " total_ms="
+        << s.interval_compile_ms << " max_ms=" << s.interval_compile_max
+        << "\nSkipped counters include recovery/cooldown, attributed to the last measured suspension reason."
+        << "\nPresent counts are successful vkQueuePresent submissions, NOT physical scanout."
+        << "\nCPU per-core sums are asynchronous guest-execution CPU time per real interval, not critical-path wall time."
+        << "\nGPU is main command-buffer timestamp elapsed time, excluding upload/present command buffers.";
+    for (size_t i = 0; i < s.metrics.size(); ++i) {
+        const auto& m = s.metrics[i];
+        out << '\n' << MetricNames[i] << ": " << Value(m);
+        if (m.count) out << " p95=" << m.Percentile(.95) << " p99=" << m.Percentile(.99)
+            << " session_count=" << m.total_count << " session_total_ms=" << m.total << " max_ms=" << m.maximum;
+    }
+    for (size_t i = 0; i < s.counters.size(); ++i) out << '\n' << CounterNames[i] << '=' << s.counters[i];
+    for (size_t i = 0; i < s.drops.size(); ++i) out << "\nDrop " << DropNames[i] << '=' << s.drops[i];
+    for (size_t i = 0; i < s.bottlenecks.size(); ++i) out << "\nBottleneck samples " << Bottlenecks[i] << '=' << s.bottlenecks[i];
+    return out.str();
+}
+GuestCpuScope::GuestCpuScope(size_t core_) : core{core_} {
+    if (Enabled() && core < cpu_ns.size()) start = ThreadNs();
+}
+GuestCpuScope::~GuestCpuScope() {
+    if (!start) return;
+    const int64_t end = ThreadNs();
+    if (end >= start) { cpu_ns[core].fetch_add(end - start, std::memory_order_relaxed); cpu_seen[core] = true; }
+}
+} // namespace Common::Android::X7Pro
