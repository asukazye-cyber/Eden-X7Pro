+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include "common/android/x7pro_governor.h"
+
+namespace Common::Android::X7Pro {
+enum class Metric : size_t {
+    CpuCore, CpuSum, GpuReal, FgCpu, FgGpu, Shader, Pipeline, Acquire, QueueAge,
+    PresentCall, FrameWait, Composite, Count
+};
+enum class Counter : size_t { RealProduced, RealPresented, Attempted, Submitted, Generated,
+    SyntheticPresented, Dropped, Count };
+bool Enabled();
+void SetDevice(std::string_view gpu, std::string_view driver);
+void StartSession(std::string_view game, uint64_t title_id);
+void StopSession();
+void RealFrame();
+void Sample(Metric metric, double ms);
+void Count(Counter counter);
+void Rejected(Drop reason);
+void GpuUnavailable(std::string_view reason);
+Decision Admit(bool queue_ready);
+bool ReducedQuality();
+void Presented(bool synthetic);
+std::string Diagnostics(bool detailed = false);
+
+// Thread CPU time measures guest execution, excluding descheduling and UI work.
+// Per-core aggregates are sampled at host real-frame boundaries, not exact guest-frame costs.
+class GuestCpuScope {
+public:
+    explicit GuestCpuScope(size_t core);
+    ~GuestCpuScope();
+private:
+    size_t core;
+    int64_t start{};
+};
+class Scope {
+public:
+    explicit Scope(Metric metric) : metric{metric}, enabled{Enabled()} {
+        if (enabled) start = std::chrono::steady_clock::now();
+    }
+    ~Scope() {
+        Stop();
+    }
+    void Stop() {
+        if (enabled) Sample(metric, std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - start).count());
+        enabled = false;
+    }
+private:
+    Metric metric;
+    bool enabled;
+    std::chrono::steady_clock::time_point start{};
+};
+} // namespace Common::Android::X7Pro
