@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace GPU::Logging {
+
+// Always-on, allocation-free recording for renderer failure triage. This intentionally records
+// compact numeric facts rather than Vulkan object ownership or guest data.
+enum class FlightEvent : u32 {
+    DeviceProfile,
+    Submit,
+    PresentCopy,
+    PresentBlit,
+    PipelineHit,
+    PipelineMiss,
+    DescriptorWrite,
+    DescriptorReuse,
+    OptimizedBarrier,
+    GenericBarrier,
+    AppletReadback,
+    BudgetState,
+    DeviceLost,
+};
+
+struct FlightEntry {
+    u64 sequence{};
+    u64 timestamp_ns{};
+    FlightEvent event{};
+    u64 arg0{};
+    u64 arg1{};
+    u64 arg2{};
+};
+
+class FlightRecorder {
+public:
+    static constexpr size_t Capacity = 256;
+
+    static FlightRecorder& Get();
+
+    void Record(FlightEvent event, u64 arg0 = 0, u64 arg1 = 0, u64 arg2 = 0) noexcept;
+    [[nodiscard]] std::vector<FlightEntry> Snapshot() const;
+    [[nodiscard]] std::string FormatSnapshot() const;
+
+    // Writes one bounded, fixed-name report per process. Safe to call from each device-lost site.
+    void DumpOnce(std::string_view reason) noexcept;
+
+private:
+    struct Slot {
+        std::atomic<u64> sequence{};
+        std::atomic<u64> timestamp_ns{};
+        std::atomic<u32> event{};
+        std::atomic<u64> arg0{};
+        std::atomic<u64> arg1{};
+        std::atomic<u64> arg2{};
+    };
+
+    std::array<Slot, Capacity> slots{};
+    std::atomic<u64> next_sequence{1};
+    std::atomic_flag dumped = ATOMIC_FLAG_INIT;
+};
+
+inline void RecordFlight(FlightEvent event, u64 arg0 = 0, u64 arg1 = 0,
+                         u64 arg2 = 0) noexcept {
+    FlightRecorder::Get().Record(event, arg0, arg1, arg2);
+}
+
+} // namespace GPU::Logging
