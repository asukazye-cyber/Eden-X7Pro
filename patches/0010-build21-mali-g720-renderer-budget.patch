diff --git a/src/common/android/x7pro_budget_store.cpp b/src/common/android/x7pro_budget_store.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..974588bbb1ee408f3cd8194e197ce8ac7e056aba
--- /dev/null
+++ b/src/common/android/x7pro_budget_store.cpp
@@ -0,0 +1,174 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/android/x7pro_budget_store.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <fstream>
+#include <mutex>
+#include <vector>
+
+#include "common/fs/fs.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+
+namespace Common::Android::X7Pro {
+namespace {
+
+constexpr std::array<char, 8> Magic{'X', '7', 'B', 'U', 'D', '2', '1', '\0'};
+constexpr u32 Version = 1;
+constexpr u32 MaxRecords = 32;
+constexpr size_t SerializedRecordBytes = sizeof(u64) * 2 + sizeof(u32) * 2 + sizeof(float) * 4;
+constexpr size_t HeaderBytes = Magic.size() + sizeof(Version) + sizeof(u32);
+constexpr size_t MaxFileBytes = HeaderBytes + MaxRecords * SerializedRecordBytes;
+std::mutex store_mutex;
+
+std::filesystem::path StorePath() {
+    return Common::FS::GetEdenPath(Common::FS::EdenPath::CacheDir) /
+           "x7pro_budget_history.bin";
+}
+
+bool Valid(const TitleBudgetHistory& record) {
+    return record.title_id != 0 && record.real_samples <= 10'000'000 &&
+           std::isfinite(record.real_average_ms) && record.real_average_ms >= 0.0f &&
+           record.real_average_ms <= 500.0f && std::isfinite(record.gpu_average_ms) &&
+           record.gpu_average_ms >= 0.0f && record.gpu_average_ms <= 500.0f &&
+           std::isfinite(record.deadline_miss_ratio) && record.deadline_miss_ratio >= 0.0f &&
+           record.deadline_miss_ratio <= 1.0f && std::isfinite(record.fg_accept_ratio) &&
+           record.fg_accept_ratio >= 0.0f && record.fg_accept_ratio <= 1.0f;
+}
+
+void ReadRecord(std::istream& file, TitleBudgetHistory& record) {
+    file.read(reinterpret_cast<char*>(&record.title_id), sizeof(record.title_id));
+    file.read(reinterpret_cast<char*>(&record.last_used_unix_seconds),
+              sizeof(record.last_used_unix_seconds));
+    file.read(reinterpret_cast<char*>(&record.sessions), sizeof(record.sessions));
+    file.read(reinterpret_cast<char*>(&record.real_samples), sizeof(record.real_samples));
+    file.read(reinterpret_cast<char*>(&record.real_average_ms), sizeof(record.real_average_ms));
+    file.read(reinterpret_cast<char*>(&record.gpu_average_ms), sizeof(record.gpu_average_ms));
+    file.read(reinterpret_cast<char*>(&record.deadline_miss_ratio),
+              sizeof(record.deadline_miss_ratio));
+    file.read(reinterpret_cast<char*>(&record.fg_accept_ratio), sizeof(record.fg_accept_ratio));
+}
+
+void WriteRecord(std::ostream& file, const TitleBudgetHistory& record) {
+    file.write(reinterpret_cast<const char*>(&record.title_id), sizeof(record.title_id));
+    file.write(reinterpret_cast<const char*>(&record.last_used_unix_seconds),
+               sizeof(record.last_used_unix_seconds));
+    file.write(reinterpret_cast<const char*>(&record.sessions), sizeof(record.sessions));
+    file.write(reinterpret_cast<const char*>(&record.real_samples), sizeof(record.real_samples));
+    file.write(reinterpret_cast<const char*>(&record.real_average_ms), sizeof(record.real_average_ms));
+    file.write(reinterpret_cast<const char*>(&record.gpu_average_ms), sizeof(record.gpu_average_ms));
+    file.write(reinterpret_cast<const char*>(&record.deadline_miss_ratio),
+               sizeof(record.deadline_miss_ratio));
+    file.write(reinterpret_cast<const char*>(&record.fg_accept_ratio), sizeof(record.fg_accept_ratio));
+}
+
+std::vector<TitleBudgetHistory> LoadAll() {
+    const auto path = StorePath();
+    std::error_code ec;
+    const u64 size = std::filesystem::file_size(path, ec);
+    if (ec) {
+        return {};
+    }
+    if (size < HeaderBytes || size > MaxFileBytes) {
+        Common::FS::RemoveFile(path);
+        return {};
+    }
+    try {
+        std::ifstream file(path, std::ios::binary);
+        file.exceptions(std::ifstream::failbit | std::ifstream::badbit);
+        std::array<char, 8> magic{};
+        u32 version{};
+        u32 count{};
+        file.read(magic.data(), magic.size());
+        file.read(reinterpret_cast<char*>(&version), sizeof(version));
+        file.read(reinterpret_cast<char*>(&count), sizeof(count));
+        if (magic != Magic || version != Version || count > MaxRecords ||
+            size != HeaderBytes + count * SerializedRecordBytes) {
+            file.close();
+            Common::FS::RemoveFile(path);
+            return {};
+        }
+        std::vector<TitleBudgetHistory> records(count);
+        for (auto& record : records) {
+            ReadRecord(file, record);
+            if (!Valid(record)) {
+                file.close();
+                Common::FS::RemoveFile(path);
+                return {};
+            }
+        }
+        return records;
+    } catch (const std::ios_base::failure&) {
+        Common::FS::RemoveFile(path);
+        return {};
+    }
+}
+
+void SaveAll(std::vector<TitleBudgetHistory> records) {
+    std::ranges::sort(records, std::greater{}, &TitleBudgetHistory::last_used_unix_seconds);
+    if (records.size() > MaxRecords) {
+        records.resize(MaxRecords);
+    }
+    const auto path = StorePath();
+    const auto temporary = path.string() + ".tmp";
+    static_cast<void>(Common::FS::CreateDir(path.parent_path()));
+    try {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        file.exceptions(std::ofstream::failbit | std::ofstream::badbit);
+        const u32 count = static_cast<u32>(records.size());
+        file.write(Magic.data(), Magic.size());
+        file.write(reinterpret_cast<const char*>(&Version), sizeof(Version));
+        file.write(reinterpret_cast<const char*>(&count), sizeof(count));
+        for (const auto& record : records) {
+            WriteRecord(file, record);
+        }
+        file.flush();
+        file.close();
+        Common::FS::RemoveFile(path);
+        if (!Common::FS::RenameFile(temporary, path)) {
+            Common::FS::RemoveFile(temporary);
+        }
+    } catch (const std::ios_base::failure&) {
+        Common::FS::RemoveFile(temporary);
+    }
+}
+
+} // namespace
+
+std::optional<TitleBudgetHistory> LoadTitleBudgetHistory(u64 title_id) {
+    if (title_id == 0) {
+        return std::nullopt;
+    }
+    std::scoped_lock lock{store_mutex};
+    auto records = LoadAll();
+    const auto it = std::ranges::find(records, title_id, &TitleBudgetHistory::title_id);
+    return it != records.end() ? std::optional{*it} : std::nullopt;
+}
+
+void SaveTitleBudgetHistory(const TitleBudgetHistory& history) {
+    if (!Valid(history)) {
+        return;
+    }
+    std::scoped_lock lock{store_mutex};
+    auto records = LoadAll();
+    const auto it = std::ranges::find(records, history.title_id, &TitleBudgetHistory::title_id);
+    if (it != records.end()) {
+        *it = history;
+    } else {
+        records.push_back(history);
+    }
+    SaveAll(std::move(records));
+}
+
+void ResetTitleBudgetHistory(u64 title_id) {
+    std::scoped_lock lock{store_mutex};
+    auto records = LoadAll();
+    std::erase_if(records, [title_id](const auto& record) { return record.title_id == title_id; });
+    SaveAll(std::move(records));
+}
+
+} // namespace Common::Android::X7Pro
