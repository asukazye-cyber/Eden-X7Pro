@@ -0,0 +1,121 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <set>
+#include <string>
+#include <string_view>
+
+#include <vulkan/vulkan_core.h>
+
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+// Keep architecture identification separate from product branding. Vulkan vendor/driver
+// properties establish the Mali family; the model string is only supplementary evidence for a
+// particular generation.
+enum class GpuArchitecture : u8 {
+    Generic,
+    MaliUnknown,
+    MaliValhall,
+    MaliFifthGen,
+};
+
+enum class GpuOptimizationMode : u8 {
+    Disabled,
+    Automatic,
+    Aggressive,
+};
+
+struct GpuCapabilities {
+    bool tile_based{};
+    bool synchronization2{};
+    bool timeline_semaphore{};
+    bool descriptor_buffer{};
+    bool memory_budget{};
+    bool image_robustness{};
+    bool pipeline_robustness{};
+    bool robustness2{};
+    bool unified_graphics_present_queue{};
+    VkQueueFlags graphics_queue_flags{};
+};
+
+struct GpuWorkarounds {
+    // The G720 path never assumes attachment contents may be discarded. DONT_CARE is selected only
+    // when the renderer has explicit guest discard/overwrite evidence.
+    bool require_proven_attachment_discard{true};
+    // General-layout transitions can also carry memory dependencies. Never suppress one merely
+    // because oldLayout == newLayout.
+    bool preserve_same_layout_dependencies{true};
+};
+
+struct GpuFastPaths {
+    bool tile_attachment_layouts{};
+    bool tile_load_op_clear{};
+    bool precise_upload_barrier{};
+    bool precise_present_barrier{};
+    bool present_copy_for_identical_extent{};
+    bool compute_descriptor_reuse{};
+};
+
+class GpuPerformanceProfile {
+public:
+    static GpuPerformanceProfile Create(
+        VkDriverId driver_id, u32 vendor_id, u32 device_id, std::string_view model_name,
+        const std::set<std::string, std::less<>>& advertised_extensions,
+        bool synchronization2, bool timeline_semaphore, bool descriptor_buffer,
+        bool memory_budget, bool image_robustness, bool robustness2,
+        VkQueueFlags graphics_queue_flags, bool unified_graphics_present_queue,
+        GpuOptimizationMode requested_mode);
+
+    [[nodiscard]] GpuArchitecture Architecture() const noexcept {
+        return architecture;
+    }
+    [[nodiscard]] const GpuCapabilities& Capabilities() const noexcept {
+        return capabilities;
+    }
+    [[nodiscard]] const GpuWorkarounds& Workarounds() const noexcept {
+        return workarounds;
+    }
+    [[nodiscard]] const GpuFastPaths& FastPaths() const noexcept {
+        return fast_paths;
+    }
+    [[nodiscard]] u32 EnabledFastPathMask() const noexcept;
+    [[nodiscard]] GpuOptimizationMode Mode() const noexcept {
+        return mode;
+    }
+    [[nodiscard]] bool IsMali() const noexcept {
+        return architecture == GpuArchitecture::MaliUnknown ||
+               architecture == GpuArchitecture::MaliValhall ||
+               architecture == GpuArchitecture::MaliFifthGen;
+    }
+    [[nodiscard]] bool IsMaliG720() const noexcept {
+        return mali_g720;
+    }
+    [[nodiscard]] bool IsActive() const noexcept {
+        return active;
+    }
+    [[nodiscard]] const std::string& ArchitectureName() const noexcept {
+        return architecture_name;
+    }
+
+    void LogActivation() const;
+
+private:
+    GpuArchitecture architecture{GpuArchitecture::Generic};
+    GpuOptimizationMode mode{GpuOptimizationMode::Disabled};
+    GpuCapabilities capabilities{};
+    GpuWorkarounds workarounds{};
+    GpuFastPaths fast_paths{};
+    bool mali_g720{};
+    bool active{};
+    u32 vendor_id{};
+    u32 device_id{};
+    VkDriverId driver_id{};
+    std::string architecture_name{"Generic"};
+    std::string model_name;
+};
