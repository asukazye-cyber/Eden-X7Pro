index 0000000000000000000000000000000000000000..180c95c527ec86db2af5353583e6227a289a5490
--- /dev/null
+++ b/src/video_core/gpu_logging/gpu_flight_recorder.cpp
@@ -0,0 +1,129 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "video_core/gpu_logging/gpu_flight_recorder.h"
+
+#include <algorithm>
+#include <chrono>
+
+#include <fmt/format.h>
+
+#include "common/fs/file.h"
+#include "common/fs/fs.h"
+#include "common/fs/path_util.h"
+
+namespace GPU::Logging {
+namespace {
+
+std::string_view EventName(FlightEvent event) {
+    switch (event) {
+    case FlightEvent::DeviceProfile:
+        return "device-profile";
+    case FlightEvent::Submit:
+        return "submit";
+    case FlightEvent::PresentCopy:
+        return "present-copy";
+    case FlightEvent::PresentBlit:
+        return "present-blit";
+    case FlightEvent::PipelineHit:
+        return "pipeline-hit";
+    case FlightEvent::PipelineMiss:
+        return "pipeline-miss";
+    case FlightEvent::DescriptorWrite:
+        return "descriptor-write";
+    case FlightEvent::DescriptorReuse:
+        return "descriptor-reuse";
+    case FlightEvent::OptimizedBarrier:
+        return "optimized-barrier";
+    case FlightEvent::GenericBarrier:
+        return "generic-barrier";
+    case FlightEvent::AppletReadback:
+        return "applet-readback";
+    case FlightEvent::BudgetState:
+        return "budget-state";
+    case FlightEvent::DeviceLost:
+        return "device-lost";
+    }
+    return "unknown";
+}
+
+} // namespace
+
+FlightRecorder& FlightRecorder::Get() {
+    static FlightRecorder recorder;
+    return recorder;
+}
+
+void FlightRecorder::Record(FlightEvent event, u64 arg0, u64 arg1, u64 arg2) noexcept {
+    const u64 sequence = next_sequence.fetch_add(1, std::memory_order_relaxed);
+    Slot& slot = slots[sequence % Capacity];
+    // Zero means unpublished. Atomic fields avoid a data race if a crash snapshot overlaps a writer.
+    slot.sequence.store(0, std::memory_order_relaxed);
+    const auto now = std::chrono::steady_clock::now().time_since_epoch();
+    slot.timestamp_ns.store(
+        static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(now).count()),
+        std::memory_order_relaxed);
+    slot.event.store(static_cast<u32>(event), std::memory_order_relaxed);
+    slot.arg0.store(arg0, std::memory_order_relaxed);
+    slot.arg1.store(arg1, std::memory_order_relaxed);
+    slot.arg2.store(arg2, std::memory_order_relaxed);
+    slot.sequence.store(sequence, std::memory_order_release);
+}
+
+std::vector<FlightEntry> FlightRecorder::Snapshot() const {
+    std::vector<FlightEntry> entries;
+    entries.reserve(Capacity);
+    for (const Slot& slot : slots) {
+        const u64 before = slot.sequence.load(std::memory_order_acquire);
+        if (before == 0) {
+            continue;
+        }
+        FlightEntry entry{
+            .sequence = before,
+            .timestamp_ns = slot.timestamp_ns.load(std::memory_order_relaxed),
+            .event = static_cast<FlightEvent>(slot.event.load(std::memory_order_relaxed)),
+            .arg0 = slot.arg0.load(std::memory_order_relaxed),
+            .arg1 = slot.arg1.load(std::memory_order_relaxed),
+            .arg2 = slot.arg2.load(std::memory_order_relaxed),
+        };
+        if (slot.sequence.load(std::memory_order_acquire) == before) {
+            entries.push_back(entry);
+        }
+    }
+    std::ranges::sort(entries, {}, &FlightEntry::sequence);
+    return entries;
+}
+
+std::string FlightRecorder::FormatSnapshot() const {
+    std::string output = "=== EDEN VULKAN FLIGHT RECORDER (bounded 256 events) ===\n";
+    for (const FlightEntry& entry : Snapshot()) {
+        output += fmt::format("{} {} ns={} args={},{},{}\n", entry.sequence,
+                              EventName(entry.event), entry.timestamp_ns, entry.arg0, entry.arg1,
+                              entry.arg2);
+    }
+    return output;
+}
+
+void FlightRecorder::DumpOnce(std::string_view reason) noexcept {
+    if (dumped.test_and_set(std::memory_order_acq_rel)) {
+        return;
+    }
+    try {
+        Record(FlightEvent::DeviceLost);
+        const auto directory = Common::FS::GetEdenPath(Common::FS::EdenPath::LogDir) / "gpu_crashes";
+        static_cast<void>(Common::FS::CreateDir(directory));
+        Common::FS::IOFile file(directory / "vulkan_flight_recorder.gpu-dump",
+                                Common::FS::FileAccessMode::Write,
+                                Common::FS::FileType::TextFile);
+        if (!file.IsOpen()) {
+            return;
+        }
+        static_cast<void>(
+            file.WriteString(fmt::format("Reason: {}\n{}", reason, FormatSnapshot())));
+        file.Flush();
+    } catch (...) {
+        // A recorder must never turn a recoverable device-lost path into another exception.
+    }
+}
+
+} // namespace GPU::Logging
