index 4db5b6f19621698178e62608c18e780222a39d3f..eb01c09f9f3b8a418e2fd9b569b4b9e78b783d97 100644
--- a/src/common/android/x7pro_governor.h
+++ b/src/common/android/x7pro_governor.h
@@ -119,6 +119,141 @@ public:
     }
 };
 
+enum class BudgetPhase : uint8_t { Warming, Headroom, Stable, Guarded, Critical, Thermal };
+
+inline constexpr const char* BudgetPhaseName(BudgetPhase phase) {
+    switch (phase) {
+    case BudgetPhase::Warming: return "WARMING";
+    case BudgetPhase::Headroom: return "HEADROOM";
+    case BudgetPhase::Stable: return "STABLE";
+    case BudgetPhase::Guarded: return "GUARDED";
+    case BudgetPhase::Critical: return "CRITICAL";
+    case BudgetPhase::Thermal: return "THERMAL";
+    }
+    return "UNKNOWN";
+}
+
+enum class BudgetWork : uint8_t {
+    FrameGeneration,
+    SpeculativeWarmup,
+    CacheMaintenance,
+    NoncriticalTransfer,
+    OptionalRendererWork,
+};
+
+struct RealFrameBudgetEvidence {
+    double latest_ms{};
+    double p95_ms{};
+    double p99_ms{};
+    double gpu_p95_ms{};
+    double cpu_p95_ms{};
+    double present_p95_ms{};
+    bool enough_real_samples{};
+    bool gpu_valid{};
+    bool cpu_valid{};
+    int thermal{-1};
+};
+
+struct RealFrameBudgetDecision {
+    BudgetPhase phase{BudgetPhase::Warming};
+    double target_ms{1000.0 / 30.0};
+    double estimated_headroom_ms{};
+    bool allow_frame_generation{};
+    bool allow_speculative_warmup{};
+    bool allow_cache_maintenance{};
+    bool allow_noncritical_transfer{};
+    bool allow_optional_renderer_work{};
+
+    [[nodiscard]] bool Allows(BudgetWork work) const {
+        switch (work) {
+        case BudgetWork::FrameGeneration: return allow_frame_generation;
+        case BudgetWork::SpeculativeWarmup: return allow_speculative_warmup;
+        case BudgetWork::CacheMaintenance: return allow_cache_maintenance;
+        case BudgetWork::NoncriticalTransfer: return allow_noncritical_transfer;
+        case BudgetWork::OptionalRendererWork: return allow_optional_renderer_work;
+        }
+        return false;
+    }
+};
+
+// Central 30 Hz real-frame controller. It never changes emulation speed or image scale. Pressure
+// transitions are fast, while recovery requires sustained evidence so optional work cannot flap.
+class RealFrameBudgetController {
+public:
+    static constexpr double TargetMs = 1000.0 / 30.0;
+
+    RealFrameBudgetDecision Update(const RealFrameBudgetEvidence& e) {
+        const double critical_path = std::max(e.gpu_p95_ms, e.cpu_p95_ms);
+        const double estimated_cost = critical_path + std::max(0.0, e.present_p95_ms);
+        decision.estimated_headroom_ms = std::clamp(TargetMs - estimated_cost, -TargetMs, TargetMs);
+
+        BudgetPhase candidate = BudgetPhase::Warming;
+        if (e.thermal >= 3) {
+            candidate = BudgetPhase::Thermal;
+        } else if (!e.enough_real_samples || !e.gpu_valid || !e.cpu_valid) {
+            candidate = BudgetPhase::Warming;
+        } else if (e.latest_ms > 38.0 || e.p95_ms > 34.0 || e.p99_ms > 45.0) {
+            candidate = BudgetPhase::Critical;
+        } else if (e.p95_ms > 31.5 || e.p99_ms > 38.0 ||
+                   decision.estimated_headroom_ms < 4.0) {
+            candidate = BudgetPhase::Guarded;
+        } else if (e.p95_ms < 30.0 && e.p99_ms < 35.0 &&
+                   decision.estimated_headroom_ms >= 6.0) {
+            candidate = BudgetPhase::Headroom;
+        } else {
+            candidate = BudgetPhase::Stable;
+        }
+
+        const auto severity = [](BudgetPhase phase) {
+            switch (phase) {
+            case BudgetPhase::Headroom: return 0;
+            case BudgetPhase::Stable: return 1;
+            case BudgetPhase::Warming: return 2;
+            case BudgetPhase::Guarded: return 3;
+            case BudgetPhase::Critical: return 4;
+            case BudgetPhase::Thermal: return 5;
+            }
+            return 5;
+        };
+        if (candidate == BudgetPhase::Thermal || severity(candidate) > severity(decision.phase)) {
+            // Thermal is immediate. Other pressure needs only two frames to reject one-off jitter.
+            pressure_streak = candidate == BudgetPhase::Thermal ? 2U : pressure_streak + 1;
+            recovery_streak = 0;
+            if (pressure_streak >= 2) decision.phase = candidate;
+        } else if (severity(candidate) < severity(decision.phase)) {
+            pressure_streak = 0;
+            if (++recovery_streak >= 45) {
+                decision.phase = candidate;
+                recovery_streak = 0;
+            }
+        } else {
+            pressure_streak = recovery_streak = 0;
+            decision.phase = candidate;
+        }
+
+        const bool headroom = decision.phase == BudgetPhase::Headroom;
+        const bool stable = decision.phase == BudgetPhase::Stable;
+        decision.allow_frame_generation = headroom || stable;
+        decision.allow_speculative_warmup = headroom && decision.estimated_headroom_ms >= 8.0;
+        decision.allow_cache_maintenance = headroom && decision.estimated_headroom_ms >= 6.0;
+        decision.allow_noncritical_transfer = headroom;
+        decision.allow_optional_renderer_work = headroom;
+        return decision;
+    }
+
+    void Reset() {
+        decision = {};
+        pressure_streak = recovery_streak = 0;
+    }
+
+    [[nodiscard]] const RealFrameBudgetDecision& Current() const { return decision; }
+
+private:
+    RealFrameBudgetDecision decision{};
+    unsigned pressure_streak{};
+    unsigned recovery_streak{};
+};
+
 inline uint64_t TimestampDelta(uint64_t begin, uint64_t end, unsigned valid_bits) {
     if (!valid_bits) return 0;
     const uint64_t mask = valid_bits >= 64 ? ~uint64_t{0} : (uint64_t{1} << valid_bits) - 1;
