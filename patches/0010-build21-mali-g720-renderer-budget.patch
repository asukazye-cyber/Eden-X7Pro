+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "video_core/gpu_logging/gpu_renderer_diagnostics.h"
+
+#include <array>
+#include <atomic>
+
+#include <fmt/format.h>
+
+namespace GPU::Logging {
+namespace {
+
+constexpr size_t CounterCount = static_cast<size_t>(RendererCounter::Count);
+std::array<std::atomic<u64>, CounterCount> counters{};
+std::atomic<bool> active_profile{};
+std::atomic<u32> selected_policy{};
+std::atomic<u32> enabled_fast_paths{};
+
+const char* PolicyName(u32 policy) {
+    switch (policy) {
+    case 0:
+        return "Off";
+    case 1:
+        return "Auto";
+    case 2:
+        return "Aggressive";
+    default:
+        return "Unknown";
+    }
+}
+
+} // namespace
+
+void ConfigureRendererDiagnostics(bool profile_active, u32 policy, u32 fast_path_mask) noexcept {
+    active_profile.store(profile_active, std::memory_order_relaxed);
+    selected_policy.store(policy, std::memory_order_relaxed);
+    enabled_fast_paths.store(fast_path_mask, std::memory_order_relaxed);
+}
+
+void CountRenderer(RendererCounter counter, u64 amount) noexcept {
+    const size_t index = static_cast<size_t>(counter);
+    if (index < counters.size()) {
+        counters[index].fetch_add(amount, std::memory_order_relaxed);
+    }
+}
+
+u64 RendererCount(RendererCounter counter) noexcept {
+    const size_t index = static_cast<size_t>(counter);
+    return index < counters.size() ? counters[index].load(std::memory_order_relaxed) : 0;
+}
+
+std::string RendererDiagnosticsText() {
+    const u64 hits = RendererCount(RendererCounter::PipelineHit);
+    const u64 misses = RendererCount(RendererCounter::PipelineMiss);
+    const u64 lookups = hits + misses;
+    const std::string hit_rate =
+        lookups != 0 ? fmt::format("{:.1f}%", 100.0 * static_cast<double>(hits) / lookups)
+                     : "N/A";
+    return fmt::format(
+        "Vulkan profile: {} policy={} fast-path-mask=0x{:x}\n"
+        "Pipeline map (session): hit={} miss={} hit-rate={} created={} disk-loaded={}\n"
+        "Descriptor buffer (session): write={} reuse={}\n"
+        "Renderer commands (session): submit={} precise-barrier={} generic-barrier={} "
+        "tile-clear={} scope-continue={}\n"
+        "Present (session): copy={} blit={}\n"
+        "Applet readback (session): requests={} allocations={} reuses={}",
+        active_profile.load(std::memory_order_relaxed) ? "Mali-G720 ACTIVE" : "generic/inactive",
+        PolicyName(selected_policy.load(std::memory_order_relaxed)),
+        enabled_fast_paths.load(std::memory_order_relaxed), hits, misses, hit_rate,
+        RendererCount(RendererCounter::PipelineCreated),
+        RendererCount(RendererCounter::DiskPipelineLoaded),
+        RendererCount(RendererCounter::DescriptorBufferWrite),
+        RendererCount(RendererCounter::DescriptorBufferReuse),
+        RendererCount(RendererCounter::Submission),
+        RendererCount(RendererCounter::PreciseBarrier),
+        RendererCount(RendererCounter::GenericBarrier),
+        RendererCount(RendererCounter::TileLoadClear),
+        RendererCount(RendererCounter::RenderScopeContinuation),
+        RendererCount(RendererCounter::PresentCopy), RendererCount(RendererCounter::PresentBlit),
+        RendererCount(RendererCounter::AppletReadback),
+        RendererCount(RendererCounter::AppletDownloadAllocation),
+        RendererCount(RendererCounter::AppletDownloadReuse));
+}
+
+} // namespace GPU::Logging
