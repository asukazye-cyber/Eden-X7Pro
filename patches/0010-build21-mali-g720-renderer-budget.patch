+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <optional>
+
+#include "common/common_types.h"
+
+namespace Common::Android::X7Pro {
+
+struct TitleBudgetHistory {
+    u64 title_id{};
+    u64 last_used_unix_seconds{};
+    u32 sessions{};
+    u32 real_samples{};
+    float real_average_ms{};
+    float gpu_average_ms{};
+    float deadline_miss_ratio{};
+    float fg_accept_ratio{};
+};
+
+// A versioned 32-title LRU file. Invalid, stale-version, oversized, and non-finite data is reset;
+// no persisted value can enable a Vulkan path or bypass fresh-frame warmup.
+[[nodiscard]] std::optional<TitleBudgetHistory> LoadTitleBudgetHistory(u64 title_id);
+void SaveTitleBudgetHistory(const TitleBudgetHistory& history);
+void ResetTitleBudgetHistory(u64 title_id);
+
+} // namespace Common::Android::X7Pro
