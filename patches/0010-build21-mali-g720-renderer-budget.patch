index 0000000000000000000000000000000000000000..9c8bae98fb3e30f6796535480507f12df0fb2e07
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_sync_optimizer.h
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+
+#include "video_core/vulkan_common/vulkan_device.h"
+
+namespace Vulkan::Sync {
+
+struct MemoryDependency {
+    VkPipelineStageFlags src_stages{};
+    VkPipelineStageFlags dst_stages{};
+    VkAccessFlags src_access{};
+    VkAccessFlags dst_access{};
+};
+
+// Upload command buffers contain transfer writes and execute immediately before the main command
+// buffer in the same queue submission. This mask names every consumer used by Eden instead of
+// forcing unrelated host/top/bottom/all-command stages to participate. If the central profile is
+// not active, return the original conservative dependency unchanged.
+inline MemoryDependency UploadToMain(const Device& device) noexcept {
+    if (!device.GetGpuPerformanceProfile().FastPaths().precise_upload_barrier) {
+        return {
+            .src_stages = VK_PIPELINE_STAGE_TRANSFER_BIT,
+            .dst_stages = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+            .src_access = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dst_access = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+        };
+    }
+    return {
+        .src_stages = VK_PIPELINE_STAGE_TRANSFER_BIT,
+        .dst_stages = VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT |
+                      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+                      VK_PIPELINE_STAGE_TRANSFER_BIT,
+        .src_access = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dst_access = VK_ACCESS_INDIRECT_COMMAND_READ_BIT | VK_ACCESS_INDEX_READ_BIT |
+                      VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_UNIFORM_READ_BIT |
+                      VK_ACCESS_INPUT_ATTACHMENT_READ_BIT | VK_ACCESS_SHADER_READ_BIT |
+                      VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT |
+                      VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+                      VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                      VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+                      VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+    };
+}
+
+} // namespace Vulkan::Sync
