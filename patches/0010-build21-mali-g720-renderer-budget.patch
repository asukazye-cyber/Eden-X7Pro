new file mode 100644
index 0000000000000000000000000000000000000000..e8969daf9fced96bd3e94caebabf9b0e32ce1b75
--- /dev/null
+++ b/src/video_core/vulkan_common/vulkan_gpu_profile.cpp
@@ -0,0 +1,158 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "video_core/vulkan_common/vulkan_gpu_profile.h"
+
+#include <algorithm>
+#include <cctype>
+
+#ifndef EDEN_GPU_PROFILE_POLICY_ONLY
+#include "common/logging.h"
+#endif
+
+namespace Vulkan {
+namespace {
+
+constexpr u32 ARM_VENDOR_ID = 0x13B5;
+
+std::string CompactLower(std::string_view value) {
+    std::string result;
+    result.reserve(value.size());
+    for (const unsigned char c : value) {
+        if (std::isalnum(c) != 0) {
+            result.push_back(static_cast<char>(std::tolower(c)));
+        }
+    }
+    return result;
+}
+
+bool HasExtension(const std::set<std::string, std::less<>>& extensions,
+                  std::string_view extension) {
+    return extensions.contains(extension);
+}
+
+[[maybe_unused]] const char* ModeName(GpuOptimizationMode mode) {
+    switch (mode) {
+    case GpuOptimizationMode::Disabled:
+        return "off";
+    case GpuOptimizationMode::Automatic:
+        return "auto";
+    case GpuOptimizationMode::Aggressive:
+        return "aggressive";
+    }
+    return "off";
+}
+
+} // Anonymous namespace
+
+GpuPerformanceProfile GpuPerformanceProfile::Create(
+    VkDriverId driver_id_, u32 vendor_id_, u32 device_id_, std::string_view model_name_,
+    const std::set<std::string, std::less<>>& advertised_extensions,
+    bool synchronization2, bool timeline_semaphore, bool descriptor_buffer, bool memory_budget,
+    bool image_robustness, bool robustness2, VkQueueFlags graphics_queue_flags,
+    bool unified_graphics_present_queue, GpuOptimizationMode requested_mode) {
+    GpuPerformanceProfile profile;
+    profile.driver_id = driver_id_;
+    profile.vendor_id = vendor_id_;
+    profile.device_id = device_id_;
+    profile.model_name = model_name_;
+    profile.mode = requested_mode;
+
+    const std::string compact_name = CompactLower(model_name_);
+    const bool arm_vendor = vendor_id_ == ARM_VENDOR_ID;
+    const bool arm_driver = driver_id_ == VK_DRIVER_ID_ARM_PROPRIETARY;
+    const bool mali_name = compact_name.find("mali") != std::string::npos;
+
+    // Vendor ID and VkDriverId are primary evidence. The model name is accepted only as
+    // supplementary evidence, never by itself.
+    const bool is_mali = arm_driver && (arm_vendor || mali_name);
+    profile.mali_g720 = is_mali && (compact_name.find("malig720") != std::string::npos ||
+                                    compact_name.find("g720mc") != std::string::npos);
+    if (profile.mali_g720) {
+        profile.architecture = GpuArchitecture::MaliFifthGen;
+        profile.architecture_name = "Mali-G720 (Fifth Gen)";
+    } else if (is_mali) {
+        // An unknown proprietary ARM Mali remains on the generic tiler policy. Do not infer a
+        // microarchitecture from driver ownership alone.
+        profile.architecture = GpuArchitecture::MaliUnknown;
+        profile.architecture_name = "Mali (unclassified)";
+    }
+
+    profile.capabilities = {
+        .tile_based = is_mali,
+        .synchronization2 = synchronization2,
+        .timeline_semaphore = timeline_semaphore,
+        .descriptor_buffer = descriptor_buffer,
+        .memory_budget = memory_budget,
+        .image_robustness = image_robustness,
+        // Eden does not enable pipeline robustness in Build 21. Recording advertisement here is
+        // capability reporting only and never places the extension in the device create list.
+        .pipeline_robustness =
+            HasExtension(advertised_extensions, "VK_EXT_pipeline_robustness"),
+        .robustness2 = robustness2 &&
+            HasExtension(advertised_extensions, "VK_EXT_robustness2"),
+        .unified_graphics_present_queue = unified_graphics_present_queue,
+        .graphics_queue_flags = graphics_queue_flags,
+    };
+
+    // Every enabled path below is Vulkan-valid without vendor-private behavior. AUTO is restricted
+    // to positively identified G720 devices. Other vendors and unclassified Mali parts preserve
+    // Eden's generic behavior.
+    profile.active = requested_mode != GpuOptimizationMode::Disabled && profile.mali_g720;
+    if (profile.active) {
+        profile.fast_paths.tile_attachment_layouts = true;
+        profile.fast_paths.tile_load_op_clear = true;
+        profile.fast_paths.precise_upload_barrier = true;
+        profile.fast_paths.precise_present_barrier = true;
+        profile.fast_paths.present_copy_for_identical_extent = true;
+        profile.fast_paths.compute_descriptor_reuse = descriptor_buffer;
+    }
+    return profile;
+}
+
+u32 GpuPerformanceProfile::EnabledFastPathMask() const noexcept {
+    return (fast_paths.tile_attachment_layouts ? 1U << 0 : 0U) |
+           (fast_paths.tile_load_op_clear ? 1U << 1 : 0U) |
+           (fast_paths.precise_upload_barrier ? 1U << 2 : 0U) |
+           (fast_paths.precise_present_barrier ? 1U << 3 : 0U) |
+           (fast_paths.present_copy_for_identical_extent ? 1U << 4 : 0U) |
+           (fast_paths.compute_descriptor_reuse ? 1U << 5 : 0U);
+}
+
+void GpuPerformanceProfile::LogActivation() const {
+#ifdef EDEN_GPU_PROFILE_POLICY_ONLY
+    return;
+#else
+    LOG_INFO(Render_Vulkan,
+             "[MaliBackend] architecture={} vendor={:#06x} device={:#010x} driver_id={} model='{}'",
+             architecture_name, vendor_id, device_id, static_cast<u32>(driver_id), model_name);
+    LOG_INFO(Render_Vulkan,
+             "[MaliBackend] capabilities sync2={} timeline={} descriptor_buffer={} memory_budget={} "
+             "image_robustness={} pipeline_robustness={} robustness2={} unified_queue={}",
+             capabilities.synchronization2, capabilities.timeline_semaphore,
+             capabilities.descriptor_buffer, capabilities.memory_budget,
+             capabilities.image_robustness, capabilities.pipeline_robustness,
+             capabilities.robustness2, capabilities.unified_graphics_present_queue);
+    if (!IsMali()) {
+        LOG_INFO(Render_Vulkan, "[MaliBackend] generic renderer active (non-Mali device)");
+        return;
+    }
+    if (!active) {
+        LOG_INFO(Render_Vulkan, "[MaliBackend] optimized backend inactive mode={} g720={}",
+                 ModeName(mode), mali_g720);
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "[MaliBackend] optimized backend active mode={}", ModeName(mode));
+    LOG_INFO(Render_Vulkan, "[MaliBackend] tile optimization active");
+    LOG_INFO(Render_Vulkan, "[MaliBackend] sync optimizer active backend={}",
+             capabilities.synchronization2 ? "synchronization2" : "legacy-barriers");
+    LOG_INFO(Render_Vulkan, "[MaliBackend] pipeline cache active identity_version=21");
+    LOG_INFO(Render_Vulkan, "[MaliBackend] resource reuse active");
+    if (!capabilities.robustness2) {
+        LOG_INFO(Render_Vulkan,
+                 "[MaliBackend] VK_EXT_robustness2 unavailable; extension is not requested or emulated");
+    }
+#endif
+}
+
+} // namespace Vulkan
