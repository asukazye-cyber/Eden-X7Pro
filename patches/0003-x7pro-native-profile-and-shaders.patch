diff --git a/src/video_core/host_shaders/mali_x7pro_interpolate.comp b/src/video_core/host_shaders/mali_x7pro_interpolate.comp
new file mode 100644
index 0000000..98a9870
--- /dev/null
+++ b/src/video_core/host_shaders/mali_x7pro_interpolate.comp
@@ -0,0 +1,79 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Motion-compensated midpoint interpolation. This deliberately preserves the current frame for
+// low-confidence or high-edge regions instead of fabricating unstable HUD/text pixels.
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(rgba8, set = 0, binding = 0) uniform readonly image2D previous_frame;
+layout(rgba8, set = 0, binding = 1) uniform readonly image2D current_frame;
+layout(rg16f, set = 0, binding = 2) uniform readonly image2D motion_vectors;
+layout(r8, set = 0, binding = 3) uniform readonly image2D confidence_image;
+layout(rgba8, set = 0, binding = 4) uniform writeonly image2D generated_frame;
+
+layout(push_constant) uniform InterpolationParameters {
+    uvec2 frame_extent;
+    uvec2 motion_extent;
+    uint motion_scale;
+    uint reserved;
+    float interpolation_time;
+    float minimum_confidence;
+    float edge_threshold;
+    float reserved_float;
+} params;
+
+ivec2 ClampFrame(ivec2 coord) {
+    return clamp(coord, ivec2(0), ivec2(params.frame_extent) - ivec2(1));
+}
+
+vec4 LoadCurrentLinear(vec2 coord) {
+    const vec2 clamped = clamp(coord, vec2(0.0), vec2(params.frame_extent) - vec2(1.0));
+    const ivec2 base = ivec2(floor(clamped));
+    const vec2 fraction = fract(clamped);
+    const vec4 a = imageLoad(current_frame, ClampFrame(base));
+    const vec4 b = imageLoad(current_frame, ClampFrame(base + ivec2(1, 0)));
+    const vec4 c = imageLoad(current_frame, ClampFrame(base + ivec2(0, 1)));
+    const vec4 d = imageLoad(current_frame, ClampFrame(base + ivec2(1, 1)));
+    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
+}
+
+vec4 LoadPreviousLinear(vec2 coord) {
+    const vec2 clamped = clamp(coord, vec2(0.0), vec2(params.frame_extent) - vec2(1.0));
+    const ivec2 base = ivec2(floor(clamped));
+    const vec2 fraction = fract(clamped);
+    const vec4 a = imageLoad(previous_frame, ClampFrame(base));
+    const vec4 b = imageLoad(previous_frame, ClampFrame(base + ivec2(1, 0)));
+    const vec4 c = imageLoad(previous_frame, ClampFrame(base + ivec2(0, 1)));
+    const vec4 d = imageLoad(previous_frame, ClampFrame(base + ivec2(1, 1)));
+    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
+}
+
+float EdgeStrength(ivec2 coord) {
+    const vec3 center = imageLoad(current_frame, ClampFrame(coord)).rgb;
+    const vec3 right = imageLoad(current_frame, ClampFrame(coord + ivec2(1, 0))).rgb;
+    const vec3 down = imageLoad(current_frame, ClampFrame(coord + ivec2(0, 1))).rgb;
+    return max(length(center - right), length(center - down));
+}
+
+void main() {
+    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(uvec2(coord), params.frame_extent))) {
+        return;
+    }
+
+    const ivec2 motion_coord = clamp(coord / int(params.motion_scale), ivec2(0),
+                                     ivec2(params.motion_extent) - ivec2(1));
+    const vec2 motion = imageLoad(motion_vectors, motion_coord).xy;
+    float confidence = imageLoad(confidence_image, motion_coord).x;
+    if (EdgeStrength(coord) > params.edge_threshold) {
+        confidence *= 0.5;
+    }
+
+    const vec4 current = LoadCurrentLinear(vec2(coord) - motion * params.interpolation_time);
+    const vec4 previous = LoadPreviousLinear(vec2(coord) +
+                                              motion * (1.0 - params.interpolation_time));
+    const float blend = confidence >= params.minimum_confidence ? confidence : 0.0;
+    imageStore(generated_frame, coord, mix(current, previous, 0.5 * blend));
+}
diff --git a/src/video_core/host_shaders/mali_x7pro_motion.comp b/src/video_core/host_shaders/mali_x7pro_motion.comp
new file mode 100644
index 0000000..7b0bb78
--- /dev/null
+++ b/src/video_core/host_shaders/mali_x7pro_motion.comp
@@ -0,0 +1,72 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Low-resolution block matching for the self-contained Mali frame generator. Each invocation
+// writes one motion cell; the interpolation pass reuses it for a small source-image region.
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(rgba8, set = 0, binding = 0) uniform readonly image2D previous_frame;
+layout(rgba8, set = 0, binding = 1) uniform readonly image2D current_frame;
+layout(rg16f, set = 0, binding = 2) uniform writeonly image2D motion_vectors;
+layout(r8, set = 0, binding = 3) uniform writeonly image2D confidence_image;
+
+layout(push_constant) uniform MotionParameters {
+    uvec2 frame_extent;
+    uvec2 motion_extent;
+    uint motion_scale;
+    uint search_radius;
+    float confidence_bias;
+    float reserved;
+} params;
+
+float Luma(vec3 color) {
+    return dot(color, vec3(0.2126, 0.7152, 0.0722));
+}
+
+ivec2 ClampFrame(ivec2 coord) {
+    return clamp(coord, ivec2(0), ivec2(params.frame_extent) - ivec2(1));
+}
+
+float MatchCost(ivec2 current_coord, ivec2 candidate) {
+    const ivec2 taps[5] = ivec2[5](ivec2(0), ivec2(-2, 0), ivec2(2, 0),
+                                   ivec2(0, -2), ivec2(0, 2));
+    float cost = 0.0;
+    for (uint i = 0; i < 5; ++i) {
+        const float a = Luma(imageLoad(current_frame, ClampFrame(current_coord + taps[i])).rgb);
+        const float b = Luma(imageLoad(previous_frame,
+                                       ClampFrame(current_coord + candidate + taps[i])).rgb);
+        cost += abs(a - b);
+    }
+    return cost * 0.2;
+}
+
+void main() {
+    const ivec2 motion_coord = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(uvec2(motion_coord), params.motion_extent))) {
+        return;
+    }
+
+    const ivec2 source_coord = ClampFrame(motion_coord * int(params.motion_scale) +
+                                          ivec2(int(params.motion_scale) / 2));
+    float best_cost = 1e20;
+    ivec2 best_offset = ivec2(0);
+    const int radius = int(params.search_radius);
+    for (int y = -radius; y <= radius; ++y) {
+        for (int x = -radius; x <= radius; ++x) {
+            const ivec2 candidate = ivec2(x, y);
+            const float cost = MatchCost(source_coord, candidate);
+            if (cost < best_cost) {
+                best_cost = cost;
+                best_offset = candidate;
+            }
+        }
+    }
+
+    // A confidence derived from the actual temporal residual prevents aggressive warping on HUD,
+    // disocclusions, fades, and material changes.
+    const float confidence = clamp(1.0 - best_cost / max(params.confidence_bias, 0.001), 0.0, 1.0);
+    imageStore(motion_vectors, motion_coord, vec4(vec2(best_offset), 0.0, 1.0));
+    imageStore(confidence_image, motion_coord, vec4(confidence, 0.0, 0.0, 1.0));
+}
